<ui:FluentWindow x:Class="CargoPlanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:CargoPlanApp.Converters"
        xmlns:behaviors="clr-namespace:CargoPlanApp.Behaviors"
        xmlns:vm="clr-namespace:CargoPlanApp.ViewModels"
        xmlns:views="clr-namespace:CargoPlanApp.Views"
        xmlns:local="clr-namespace:CargoPlanApp"
        Title="MT RINA Cargo Plan" Height="800" Width="1200"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Loaded="Window_Loaded"
        TextElement.Foreground="{DynamicResource App.Foreground}">
    <ui:FluentWindow.Resources>
        <!-- True -> Visible, False -> Collapsed. Используется для скрытия подписей групп
             (NavigationViewItemHeader) при сворачивании сайдбара в compact-режим. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </ui:FluentWindow.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Нативный заголовок WPF-UI (заменяет самодельный chrome) -->
        <ui:TitleBar Grid.Row="0" Title="MT RINA Cargo Plan" Icon="pack://application:,,,/app.ico"/>
        <!-- Боковое меню (Win11 Settings style) + контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:NavigationView x:Name="MainNavigation" Grid.Column="0"
                               PaneDisplayMode="Left"
                               IsPaneOpen="True"
                               OpenPaneLength="240"
                               PaneTitle="MT RINA"
                               IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItemHeader Text="Planning"
                        Visibility="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:NavigationViewItem x:Name="NavTableItem" Content="Table" IsActive="True" Click="NavTableItem_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Table24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem x:Name="NavCargoPlanItem" Content="Cargo Plan" Click="NavCargoPlanItem_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DataTrending24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItemHeader Text="File"
                        Visibility="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:NavigationViewItem Content="New" Click="NavNew_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Open" Click="NavOpen_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Save" Click="NavSave_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Save24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Save As" Click="NavSaveAs_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="SaveCopy24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Print" Click="NavPrint_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Print24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Products" Click="NavProducts_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="BoxMultiple24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="Tanks' capacities" Click="NavMaxVolumes_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Ruler24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
            <Border Grid.Column="1"
                    Focusable="False"
                    Background="{DynamicResource NavigationViewContentBackground}"
                    BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid x:Name="ContentHost" Focusable="False">
                    <!-- Раздел Table -->
                    <Grid x:Name="TableSection" Margin="10" Focusable="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Focusable="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="CargoDataGrid" Grid.Column="0" ItemsSource="{Binding CargoTanks}" AutoGenerateColumns="False"
                                       behaviors:ExcelNavigationBehavior.IsEnabled="True"
                                       CanUserAddRows="False" CanUserDeleteRows="False"
                                       SelectionUnit="Cell"
                                       SelectionMode="Single"
                                       KeyboardNavigation.TabNavigation="None"
                                       FocusVisualStyle="{x:Null}"
                                       Background="{DynamicResource CardBackground}"
                                       RowBackground="Transparent"
                                       AlternatingRowBackground="Transparent"
                                       CellStyle="{StaticResource EditableCellStyle}"
                                       RowHeight="33"
                                       ColumnHeaderHeight="38"
                                       Style="{StaticResource FluentDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tank No" Binding="{Binding TankNo}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                    <DataGridTemplateColumn Header="Grade" Width="*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ProductColor, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="2">
                                                    <ComboBox ItemsSource="{Binding DataContext.AllProductNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding SelectedProductName, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource DefaultComboBoxStyle}"
                                                              MinHeight="0" Height="26" VerticalAlignment="Center"
                                                              Padding="8,0,8,0" HorizontalContentAlignment="Stretch"
                                                              Width="120" Margin="2">
                                                        <!-- 10d: шаблон WPF-UI рисует стрелку в отдельной колонке, но
                                                             внешний грид привязан к HorizontalContentAlignment. При Center
                                                             он сжимается по контенту и стрелка «уезжает» в середину ячейки.
                                                             Stretch растягивает грид на всю ячейку (клик в любом месте
                                                             открывает список), стрелку скрываем, а название продукта
                                                             центрируем через ItemTemplate. -->
                                                        <ComboBox.Resources>
                                                            <Style TargetType="{x:Type ui:SymbolIcon}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Style>
                                                        </ComboBox.Resources>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Density at 15°C" Binding="{Binding Density15, StringFormat=F4}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                    <DataGridTemplateColumn Header="Weight VAC, mt" Width="*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:TextBox Text="{Binding Weight, Converter={StaticResource StringToDoubleConverter}, ConverterParameter=F3, UpdateSourceTrigger=LostFocus}"
                                                            Width="80" Height="26" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Volume, m³" Binding="{Binding Volume, StringFormat=F3}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                    <DataGridTextColumn Header="Tank filling, %" Binding="{Binding FillPercent, StringFormat=F1}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                    <DataGridTemplateColumn Header="Temp, °C" Width="*" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:TextBox Text="{Binding Temperature, Converter={StaticResource StringToDoubleConverter}, ConverterParameter=F1, UpdateSourceTrigger=LostFocus}"
                                                            Width="80" Height="26" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Real density" Binding="{Binding DensityAtTemp, StringFormat=F4}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- 6.4/7a: вертикально совмещаем блок Ballast с CargoDataGrid.
                                 VerticalAlignment=Top — блок не растягивается по высоте.
                                 Padding=0/BorderThickness=0 — контент начинается от самой верхней кромки Card,
                                 чтобы заголовок «Ballast tanks» встал на уровень ColumnHeader CargoDataGrid. -->
                            <ui:Card Grid.Column="1" Margin="5,0,0,0" Focusable="False"
                                     VerticalAlignment="Top"
                                     Padding="0"
                                     BorderThickness="0">
                                <Grid Margin="12,0" Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Заголовок играет роль ColumnHeader: высота = ColumnHeaderHeight CargoDataGrid -->
                                    <Grid Grid.Row="0" Height="{Binding ColumnHeaderHeight, ElementName=CargoDataGrid}" Focusable="False">
                                        <TextBlock Text="Ballast tanks" FontWeight="SemiBold" VerticalAlignment="Center" Focusable="False"/>
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding BallastTanks}" AutoGenerateColumns="False"
                                              behaviors:ExcelNavigationBehavior.IsEnabled="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionUnit="Cell" SelectionMode="Single"
                                              KeyboardNavigation.TabNavigation="None"
                                              FocusVisualStyle="{x:Null}"
                                              Background="Transparent"
                                              RowBackground="Transparent"
                                              AlternatingRowBackground="Transparent"
                                              HeadersVisibility="None"
                                              RowHeight="{Binding RowHeight, ElementName=CargoDataGrid}"
                                              Style="{StaticResource FluentDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tank" Binding="{Binding TankNo}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                                            <DataGridTemplateColumn Header="Water, m³" Width="*" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:TextBox Text="{Binding WaterVolume, Converter={StaticResource StringToDoubleConverter}, ConverterParameter=F3, UpdateSourceTrigger=LostFocus}"
                                                                    Width="70" Height="26" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,8,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </ui:Card>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding GradeSummaries}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  FocusVisualStyle="{x:Null}"
                                  CellStyle="{StaticResource EditableCellStyle}"
                                  Style="{StaticResource FluentDataGridStyle}" Margin="0,5,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Grade" Binding="{Binding Grade}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Density at 15°C" Binding="{Binding Density15, StringFormat=F4}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Weight VAC, mt" Binding="{Binding TotalWeight, StringFormat=F3}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Volume, m³" Binding="{Binding TotalVolume, StringFormat=F3}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Avg Temp" Binding="{Binding AvgTemperature, StringFormat=F1}" CanUserSort="False"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <!-- Раздел Cargo Plan -->
                    <Grid x:Name="CargoPlanSection" Visibility="Collapsed" Focusable="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- WrapPanel: поля с увеличенной шириной помещаются в одну строку
                             при широком окне и переносятся (без обрезки и без горизонтального
                             скролла) при узком. StackPanel не переносит -> плейсхолдеры обрезались. -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                            <ComboBox SelectedValue="{Binding PlanType}" Width="150" Margin="5"
                                      Style="{StaticResource DefaultComboBoxStyle}"
                                      ItemsSource="{x:Static local:MainWindow.PlanTypes}"/>
                            <DatePicker SelectedDate="{Binding Date}" Style="{StaticResource DefaultDatePickerStyle}" Margin="5">
                                <DatePicker.Resources>
                                    <!-- Календарная кнопка DatePicker (PART_Button) — это ui:Button,
                                         отдельный tab-stop с рамкой фокуса. Отключаем и то, и другое.
                                         Implicit-стиль действует только на точный тип ui:Button,
                                         поэтому ячейки календаря (CalendarDayButton) не затрагиваются. -->
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                            <ui:TextBox Text="{Binding Voyage}" PlaceholderText="Voyage No" Width="140" Margin="5"/>
                            <ui:TextBox Text="{Binding PortOfLoading}" PlaceholderText="Port of loading" Width="175" Margin="5"/>
                            <ui:TextBox Text="{Binding Terminal}" PlaceholderText="Terminal" Width="135" Margin="5"/>
                            <ui:TextBox Text="{Binding PortOfDischarge}" PlaceholderText="Port of discharge" Width="175" Margin="5"/>
                            <ui:TextBox Text="{Binding Draft, Converter={StaticResource StringToDoubleConverter}, ConverterParameter=F3}" PlaceholderText="Maximum Draft, m" Width="145" Margin="5"/>
                            <ui:TextBox Text="{Binding WaterDensity, Converter={StaticResource StringToDoubleConverter}, ConverterParameter=F4}" PlaceholderText="Water Density" Width="135" Margin="5"/>
                        </WrapPanel>
                        <views:CargoPlanView x:Name="CargoPlanViewControl" Grid.Row="1" Margin="10"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding GradeSummaries}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  FocusVisualStyle="{x:Null}"
                                  CellStyle="{StaticResource EditableCellStyle}"
                                  Style="{StaticResource FluentDataGridStyle}" Margin="10,0,10,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Grade" Binding="{Binding Grade}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Density at 15°C" Binding="{Binding Density15, StringFormat=F4}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Weight VAC, mt" Binding="{Binding TotalWeight, StringFormat=F3}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Volume, m³" Binding="{Binding TotalVolume, StringFormat=F3}" CanUserSort="False"/>
                                <DataGridTextColumn Width="*" Header="Avg Temp" Binding="{Binding AvgTemperature, StringFormat=F1}" CanUserSort="False"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
