<Application x:Class="CargoPlanApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CargoPlanApp.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/FluentDataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Мост-кисти: нейтральные ключи, указывающие на палитру WPF-UI (Fluent).
                 Значения — цвета из DynamicResource-ключей WPF-UI, подобранные максимально близко
                 к прежним кистям MaterialDesign (см. отчёт этапа 3). App.xaml.cs перематериализует
                 кисти при смене темы, т.к. DynamicResource внутри SolidColorBrush не обновляется. -->
            <SolidColorBrush x:Key="App.Background" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
            <SolidColorBrush x:Key="App.Foreground" Color="{DynamicResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="App.TextAreaBackground" Color="{DynamicResource ControlFillColorDefault}" />
            <SolidColorBrush x:Key="App.ControlBorder" Color="{DynamicResource ControlStrokeColorTertiary}" />
            <SolidColorBrush x:Key="App.SelectionBackground" Color="{DynamicResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="App.DarkBackground" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
            <!-- Глобальные конвертеры -->
            <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>