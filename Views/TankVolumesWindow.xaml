<Window x:Class="CargoPlanApp.Views.TankVolumesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CargoPlanApp.Converters"
        Title="Maximum Tanks' Capacity" Height="500" Width="400"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="VolumesGrid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tank No" Binding="{Binding TankNo}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Max Capacity (m³)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MaxVolume, Converter={StaticResource StringToDoubleConverter}, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>