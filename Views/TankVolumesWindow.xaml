<ui:FluentWindow x:Class="CargoPlanApp.Views.TankVolumesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:CargoPlanApp.Converters"
        xmlns:behaviors="clr-namespace:CargoPlanApp.Behaviors"
        Title="Maximum Tanks' Capacity" Height="500" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextElement.Foreground="{DynamicResource App.Foreground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Maximum Tanks' Capacity" ShowMinimize="False" ShowMaximize="False"/>
        <DataGrid x:Name="VolumesGrid" Grid.Row="1" Margin="10,0,10,0" AutoGenerateColumns="False" CanUserAddRows="False"
                  behaviors:ExcelNavigationBehavior.IsEnabled="True"
                  SelectionUnit="Cell" SelectionMode="Single"
                  KeyboardNavigation.TabNavigation="None"
                  FocusVisualStyle="{x:Null}"
                  Background="{DynamicResource CardBackground}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Style="{StaticResource FluentDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tank No" Binding="{Binding TankNo}" IsReadOnly="True" Width="*" CanUserSort="False"/>
                <DataGridTemplateColumn Header="Max Capacity (m³)" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding MaxVolume, Converter={StaticResource StringToDoubleConverter}, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <ui:Button Content="Save" Click="Save_Click" Appearance="Primary" Margin="5"/>
            <ui:Button Content="Cancel" Click="Cancel_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
