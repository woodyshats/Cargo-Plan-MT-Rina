<ui:FluentWindow x:Class="CargoPlanApp.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Выбор цвета" Width="420" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextElement.Foreground="{DynamicResource App.Foreground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Выбор цвета" ShowMinimize="False" ShowMaximize="False"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,0">
            <StackPanel>
                <!-- Предпросмотр выбранного цвета + HEX -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Preview" Height="56" CornerRadius="4"
                            BorderBrush="{DynamicResource App.ControlBorder}" BorderThickness="1"
                            Background="White"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HEX" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="HexBox" IsReadOnly="True" Width="110"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource App.Foreground}"/>
                    </StackPanel>
                </Grid>

                <!-- Палитра готовых цветов -->
                <TextBlock Text="Палитра" Margin="0,16,0,6" Opacity="0.7"/>
                <ItemsControl x:Name="PaletteList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="30" Margin="3" CornerRadius="4"
                                    Background="{Binding}" BorderThickness="2"
                                    BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="Swatch_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Точный цвет (RGB) -->
                <TextBlock Text="Точный цвет" Margin="0,16,0,6" Opacity="0.7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" VerticalAlignment="Center"/>
                    <ui:NumberBox x:Name="RBox" Grid.Column="1" Minimum="0" Maximum="255"
                                  SmallChange="1" Value="0" Margin="0,0,10,0"
                                  SpinButtonPlacementMode="Hidden" MinWidth="72"
                                  MinHeight="0" Height="28" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" Padding="6,0,6,0"/>
                    <TextBlock Text="G" Grid.Column="2" VerticalAlignment="Center"/>
                    <ui:NumberBox x:Name="GBox" Grid.Column="3" Minimum="0" Maximum="255"
                                  SmallChange="1" Value="0" Margin="0,0,10,0"
                                  SpinButtonPlacementMode="Hidden" MinWidth="72"
                                  MinHeight="0" Height="28" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" Padding="6,0,6,0"/>
                    <TextBlock Text="B" Grid.Column="4" VerticalAlignment="Center"/>
                    <ui:NumberBox x:Name="BBox" Grid.Column="5" Minimum="0" Maximum="255"
                                  SmallChange="1" Value="0"
                                  SpinButtonPlacementMode="Hidden" MinWidth="72"
                                  MinHeight="0" Height="28" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" Padding="6,0,6,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="OK" Appearance="Primary" Click="Ok_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
