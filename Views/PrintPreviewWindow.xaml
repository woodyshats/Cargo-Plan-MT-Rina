<ui:FluentWindow x:Class="CargoPlanApp.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Предварительный просмотр" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextElement.Foreground="{DynamicResource App.Foreground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Предварительный просмотр" ShowMinimize="False" ShowMaximize="False"/>
        <!-- FlowDocumentReader — нативный контрол, не стилизуется WPF-UI.
             Поиск отключён (в предпросмотре не нужен и выглядит чужеродно),
             печать — своей кнопкой ниже, зум ограничен разумным диапазоном 50–200 %. -->
        <FlowDocumentReader x:Name="DocReader" Grid.Row="1"
            IsFindEnabled="False"
            IsPrintEnabled="False"
            ViewingMode="Page"
            MinZoom="50"
            MaxZoom="200"
            Zoom="100"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14">
            <ui:Button Content="Печать" Click="Print_Click" Appearance="Primary" Margin="0,0,8,0"/>
            <ui:Button Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
