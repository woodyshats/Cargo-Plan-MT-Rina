<Window x:Class="CargoPlanApp.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Предварительный просмотр" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <FlowDocumentReader x:Name="DocReader" Grid.Row="0" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Печать" Click="Print_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>