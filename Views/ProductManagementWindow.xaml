<ui:FluentWindow x:Class="CargoPlanApp.Views.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:CargoPlanApp.Converters"
        xmlns:behaviors="clr-namespace:CargoPlanApp.Behaviors"
        xmlns:local="clr-namespace:CargoPlanApp.Views"
        Title="Products" Height="450" Width="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextElement.Foreground="{DynamicResource App.Foreground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Products" ShowMinimize="False" ShowMaximize="False"/>
        <DataGrid x:Name="ProductsGrid" Grid.Row="1" Margin="10,0,10,0"
                  behaviors:ExcelNavigationBehavior.IsEnabled="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionUnit="Cell" SelectionMode="Single"
                  KeyboardNavigation.TabNavigation="None"
                  FocusVisualStyle="{x:Null}"
                  Background="{DynamicResource CardBackground}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  Style="{StaticResource FluentDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Grade Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" CanUserSort="False"/>
                <DataGridTemplateColumn Header="Density at 15°C" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding Density15, UpdateSourceTrigger=LostFocus}"
                                        Width="100"
                                        LostFocus="DensityTextBox_LostFocus"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Color" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                    Width="30" Height="30" Cursor="Hand"
                                    MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown"
                                    Tag="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,10">
            <ui:Button Content="Add" Click="Add_Click" Margin="5"/>
            <ui:Button Content="Delete" Click="Delete_Click" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <ui:Button Content="Save" Click="Save_Click" Appearance="Primary" Margin="5"/>
            <ui:Button Content="Cancel" Click="Cancel_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
