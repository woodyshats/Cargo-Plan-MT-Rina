<Window x:Class="CargoPlanApp.Views.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CargoPlanApp.Converters"
        xmlns:local="clr-namespace:CargoPlanApp.Views"
        Title="Products" Height="450" Width="650"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Grade Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                <DataGridTemplateColumn Header="Density at 15°C" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Density15, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource MaterialDesignTextBox}" Width="100"
                                     LostFocus="DensityTextBox_LostFocus"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Color" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                    Width="30" Height="30" Cursor="Hand"
                                    MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown"
                                    Tag="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="Add" Click="Add_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
            <Button Content="Delete" Click="Delete_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="5"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>